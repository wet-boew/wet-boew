#!/bin/sh

case "$(uname -s)" in
	CYGWIN*|MINGW*)
			npm ci && npm run deploy-build
		;;
	*)
			if [ $(id -u) != "0" ];
				then
					npm ci && npm run deploy-build
				else
					# Allows Linux and OSX users to run script/setup without the need for sudo
					sudo -u $(logname) npm ci
					sudo npm run deploy-build
			fi
		;;
esac
